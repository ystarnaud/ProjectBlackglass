# Unity project .gitignore (the Unity project lives at the repository root).
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity-generated folders
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Memory captures and recordings can be very large and may contain sensitive data
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Blender backup files
*.blend1
*.blend1.meta

# Autogenerated JetBrains Rider plugin and personal settings
/[Aa]ssets/Plugins/Editor/JetBrains*
.idea/
*.DotSettings.user

# Visual Studio / VS Code caches
.vs/
.vscode/

# Gradle cache directory
.gradle/

# Autogenerated solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Build output
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Scenes auto-generated by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Temporary files com.unity.test-framework.performance writes during player builds
# (normally deleted after the build, but left behind if a build fails)
/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Secrets and local environment
.env
.env.*

# Claude Code personal settings
.claude/settings.local.json
