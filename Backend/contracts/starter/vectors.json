{
  "note": "Shared starter vector. The backend's StarterPlanner and Unity's InventorySession.SeedStarter must agree on every case. Written by hand from ItemInventory.Add (open stacks fill first, then new entries of min(left, maxStack)) and SeedStarter (every grant is added to the bag, then equip takes the first bag entry of that definition). The stash is an uncapped ItemInventory filled the same way and never equipped. Each case is self-contained: items in ascending id order, the bag capacity, the starter operatives (definition guids, ascending) with grants in authored order, the stash grants. Expected: either a refusal class (second-equip-in-slot, equip-without-slot, unknown-item, bag-capacity) or, per operative guid, the bag entries as [definitionId, quantity] in creation order and the equipped definition per slot (null when empty), plus the stash entries in creation order.",
  "cases": [
    {
      "name": "equipped-rifle-and-two-medkits",
      "bagCapacity": 6,
      "items": [
        { "id": "item.medkit", "category": "consumable", "slot": "none", "stackable": true, "maxStack": 3, "healAmount": 25 },
        { "id": "item.rifle", "category": "weapon", "slot": "weapon", "stackable": false, "maxStack": 1, "healAmount": 0 }
      ],
      "operatives": [
        { "id": "00000000-0000-4000-8000-000000000001", "grants": [
          { "itemId": "item.rifle", "quantity": 1, "equip": true },
          { "itemId": "item.medkit", "quantity": 2, "equip": false }
        ] }
      ],
      "stash": [],
      "expected": {
        "operatives": {
          "00000000-0000-4000-8000-000000000001": {
            "bag": [["item.rifle", 1], ["item.medkit", 2]],
            "equipped": { "weapon": "item.rifle", "armor": null, "utility": null }
          }
        },
        "stash": []
      }
    },
