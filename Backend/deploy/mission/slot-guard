#!/bin/sh
# /opt/blackglass/agent/current/slot-guard (root:root 0755). Run only by the slot templates' ExecStartPre=+ line, as root:
#   slot-guard <slot 00..63> <attempt>
# Refuses (exit 1) to let a mission unit start while another unit of the same slot is live: two would share the slot's dynamic uid
# (security correction C1). The agent checks the same before every start; this is systemd's own last word. It only lists units.
set -eu
slot="${1:-}"
attempt="${2:-}"
printf '%s' "$slot" | grep -Eqx '[0-5][0-9]|6[0-3]' || exit 1
printf '%s' "$attempt" | grep -Eqx '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' || exit 1
systemctl="${BLACKGLASS_SYSTEMCTL:-/usr/bin/systemctl}" # the tests' fake; never set in a unit
self="blackglass-mission-$slot@$attempt.service"
listing="$("$systemctl" --no-ask-password --no-pager --no-legend --plain --full list-units --state=active,activating,deactivating,reloading -- "blackglass-mission-$slot@*.service")" || exit 1
others="$(printf '%s\n' "$listing" | awk 'NF { print $1 }' | grep -vx -- "$self" || true)"
if [ -n "$others" ]; then
  echo "slot $slot is busy: $(printf '%s' "$others" | tr '\n' ' ')" >&2
  exit 1
fi
