# /etc/systemd/system/blackglass-mission@.service (root:root 0644, fixed: no drop-in directory may exist). Spec §7.4, §9.2; A10-D7.
# One mission process per attempt; %i is a canonical lowercase UUID (the agent builds the unit name only from a validated id).
# Only the ExecStartPre=+ and ExecStopPost=+ lines run as root, each a fixed root-owned command.
[Unit]
Description=Blackglass mission %i
After=network-online.target

[Service]
Type=simple
User=blackglass-mission
Group=blackglass-mission
# The attempt's outbox (the agent reads it through the setgid group) and its log directory, created as root before the start.
ExecStartPre=+/usr/bin/install -d -o blackglass-mission -g blackglass-agent -m 2750 /var/lib/blackglass/outbox/%i
ExecStartPre=+/usr/bin/install -d -o blackglass-mission -g blackglass-mission -m 0750 /var/log/blackglass/%i
# /opt/blackglass/mission/current is a root-owned link to the server launcher release, or to the stub release for the Stage 10
# VM tests (A10-D7); the Unity server installation under /opt/blackglass/server is never changed by those tests.
ExecStart=/opt/blackglass/mission/current/run-mission %i
# The exit status systemd forgets once it collects the unit: written as root, read-only to the agent.
ExecStopPost=+/opt/blackglass/agent/current/record-exit %i
Restart=no
UMask=0027
LoadCredential=process:/run/blackglass/launch/%i/process

# Filesystem: everything read-only; only this attempt's outbox and log directories writable; other attempts invisible.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
TemporaryFileSystem=/var/lib/blackglass/outbox:ro
BindPaths=/var/lib/blackglass/outbox/%i
ReadWritePaths=/var/lib/blackglass/outbox/%i /var/log/blackglass/%i
InaccessiblePaths=-/etc/blackglass -/var/lib/blackglass/agent -/var/lib/blackglass/relay -/var/lib/blackglass/exits -/var/lib/blackglass/tunnel -/run/blackglass

# Privileges and kernel surface.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Only UDP binds (the game port; Stage 12's server uses UDP): no TCP listener, so a mission can never take the tunnel's loopback
# port and collect the agent's secret or other missions' credentials (security review I1).
SocketBindAllow=udp
SocketBindDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
SystemCallArchitectures=native

# Resources (provisional, spec §19).
MemoryMax=2G
CPUQuota=200%
TasksMax=256
