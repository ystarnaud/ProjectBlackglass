# /etc/systemd/system/blackglass-credential.socket (root:root 0644). Security correction I3: the root credential broker's only
# entrance. Only root and the blackglass-agent group (the agent alone) can connect; the broker also checks the peer is the agent's
# uid (SO_PEERCRED). One broker process per connection (Accept=yes); mission units can't see /run/blackglass at all.
[Unit]
Description=Blackglass credential broker socket

[Socket]
ListenStream=/run/blackglass/credential.sock
SocketUser=root
SocketGroup=blackglass-agent
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=8
MaxConnectionsPerSource=8

[Install]
WantedBy=sockets.target
