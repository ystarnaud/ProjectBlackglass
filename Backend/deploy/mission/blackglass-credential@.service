# /etc/systemd/system/blackglass-credential@.service (root:root 0644). Security correction I3: one connection to the credential
# broker. It runs as root (the store /run/blackglass/credentials is root's own, 0700) with no capability at all: it can create files
# in its own directory and read /etc/passwd, nothing it doesn't own. It reads one request (a canonical attempt id, a generation and
# a pc1 credential; never a path), writes <attempt>/process for the mission unit's LoadCredential, answers and exits.
[Unit]
Description=Blackglass credential broker (one connection)

[Service]
Type=simple
ExecStart=/opt/blackglass/agent/current/blackglass-credential-broker
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=DOTNET_EnableDiagnostics=0
RuntimeMaxSec=15s
UMask=0077

ProtectSystem=strict
ReadWritePaths=/run/blackglass/credentials
InaccessiblePaths=-/etc/blackglass -/var/lib/blackglass -/var/lib/private -/var/log/blackglass -/opt/blackglass/server
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
SystemCallFilter=~listen
SystemCallErrorNumber=EPERM
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=32
