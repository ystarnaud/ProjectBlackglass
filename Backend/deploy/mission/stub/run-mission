#!/bin/bash
# The Stage 10 stub mission (A10-D7): /opt/blackglass/mission/releases/stub/run-mission (root:root 0755), selected only for the VM
# tests by linking /opt/blackglass/mission/current to that release. It never touches /opt/blackglass/server.
# It runs under the real slot template (the slot's dynamic user, the template's sandbox) and follows a root-owned plan,
# /etc/blackglass-stub/plans/<attempt>/plan (key=value lines), with the result bytes beside it (<account>.json):
#   publish=<account>:<ready|written|tmp|none> ...   how far each participant's result goes in the publish contract (Stage 9 §H)
#   sleep=<seconds>                                   how long to keep running first (default 1)
#   exit=<code>                                       the exit status (default 0); "kill" ends with SIGKILL
#   probe=yes probedelay=<seconds>                    also probe the sandbox (after the delay) into $LOGS_DIRECTORY/probe.txt
#   other=<attempt> otherpid=<pid> otherslot=<NN>     a concurrent attempt to attack (security correction C1)
#   historic=<attempt>                                an ended attempt to attack (after uid reuse)
#   port=<own udp port> otherport=<its udp port>      the listener probes
# The results go to $STATE_DIRECTORY (systemd's private, per-unit outbox); the credential arrives in $CREDENTIALS_DIRECTORY.
set -u
attempt="$1"
printf '%s' "$attempt" | grep -Eqx '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' || exit 64
plan_dir="/etc/blackglass-stub/plans/$attempt"
outbox="${STATE_DIRECTORY:?}"
logdir="${LOGS_DIRECTORY:?}"
value() { sed -n "s/^$1=//p" "$plan_dir/plan" 2>/dev/null | head -n1; }
bind_probe() { # bind_probe <udp|tcp|tcp-listen> <port>: allowed or denied
  python3 - "$1" "$2" <<'PY' 2>/dev/null && echo allowed || echo denied
import socket, sys
kind, port = sys.argv[1], int(sys.argv[2])
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM if kind == "udp" else socket.SOCK_STREAM)
s.bind(("127.0.0.1", port))
if kind == "tcp-listen":
    s.listen(1)
PY
}
attack_outbox() { # attack_outbox <label> <attempt>: what this unit can do to that attempt's results, through every path it has
  local label="$1" target="$2" base
  for base in /var/lib/blackglass-outbox /var/lib/private/blackglass-outbox /var/lib/blackglass/outbox; do
    cat "$base/$target/probe.ready" >/dev/null 2>&1 && echo "${label}_read=allowed $base" && return
    (echo x > "$base/$target/intrusion") 2>/dev/null && echo "${label}_write=allowed $base" && return
    mv "$base/$target/probe.ready" "$base/$target/moved" 2>/dev/null && echo "${label}_rename=allowed $base" && return
    rm "$base/$target/probe.ready" 2>/dev/null && echo "${label}_delete=allowed $base" && return
  done
  echo "${label}_outbox=denied"
}

if [[ "$(value probe)" == yes ]]; then
  sleep "$(value probedelay || true)" 2>/dev/null || true # lets verify.sh start the other attempt first
  report="$logdir/probe.txt"
  {
    echo "uid=$(id -u)"
    # The process credential arrives through LoadCredential only; its hash, never the credential, goes in the report.
    if [[ -r "${CREDENTIALS_DIRECTORY:-/nonexistent}/process" ]]; then
      echo "credential=readable"
      echo "credential_sha256=$(sha256sum < "$CREDENTIALS_DIRECTORY/process" | cut -d' ' -f1)"
    else
      echo "credential=missing"
    fi
    ls /run/blackglass >/dev/null 2>&1 && echo "run_blackglass=visible" || echo "run_blackglass=invisible" # an inaccessible path still exists
    [[ -e /etc/blackglass/agent/host-secret ]] && echo "host_secret=visible" || echo "host_secret=invisible"
    [[ -e /var/lib/blackglass/agent ]] && echo "agent_state=visible" || echo "agent_state=invisible"
    echo "private_outboxes=$(ls -1 /var/lib/private/blackglass-outbox 2>/dev/null | tr '\n' ',')"
    other="$(value other)"
    if [[ -n "$other" ]]; then
      attack_outbox other "$other"
      # Through the other attempt's process: /proc (environment, memory, descriptors, root), signals, its credential, its logs.
      pid="$(value otherpid)"
      if [[ -n "$pid" && -d "/proc/$pid" ]]; then echo "other_process=visible"; else echo "other_process=invisible"; fi
      cat "/proc/$pid/environ" >/dev/null 2>&1 && echo "other_environ=allowed" || echo "other_environ=denied"
      head -c 1 "/proc/$pid/mem" >/dev/null 2>&1 && echo "other_mem=allowed" || echo "other_mem=denied"
      ls "/proc/$pid/fd" >/dev/null 2>&1 && echo "other_fd=allowed" || echo "other_fd=denied"
      cat "/proc/$pid/root/var/lib/blackglass-outbox/$other/probe.ready" >/dev/null 2>&1 && echo "other_proc_root=allowed" || echo "other_proc_root=denied"
      kill -0 "$pid" 2>/dev/null && echo "other_signal=allowed" || echo "other_signal=denied"
      cat "/run/credentials/blackglass-mission-$(value otherslot)@$other.service/process" >/dev/null 2>&1 && echo "other_credential=readable" || echo "other_credential=denied"
      { ls "/var/log/blackglass-mission/$other/" || ls "/var/log/private/blackglass-mission/$other/"; } >/dev/null 2>&1 && echo "other_logs=readable" || echo "other_logs=denied" # "/": through the link
    fi
    historic="$(value historic)"
    [[ -n "$historic" ]] && attack_outbox historic "$historic"
    # Listeners (security review I1 and the network-listener correction).
    echo "tcp_listen_5081=$(bind_probe tcp-listen 5081)"
    echo "tcp_bind_5081=$(bind_probe tcp 5081)"
    port="$(value port)"
    [[ -n "$port" ]] && echo "udp_own_port=$(bind_probe udp "$port")"
    otherport="$(value otherport)"
    [[ -n "$otherport" ]] && echo "udp_other_port=$(bind_probe udp "$otherport")"
    echo own > "$outbox/probe.ready" && echo "own_write=allowed" || echo "own_write=denied"
    touch /etc/blackglass-intrusion 2>/dev/null && echo "etc_write=allowed" || echo "etc_write=denied"
  } > "$report" 2>&1
fi

for entry in $(value publish); do
  account="${entry%%:*}" stage="${entry##*:}"
  src="$plan_dir/$account.json"
  [[ -f "$src" ]] || continue
  case "$stage" in
    none) ;;
    tmp) head -c 40 "$src" > "$outbox/$account.manifest.tmp"; sync "$outbox/$account.manifest.tmp" ;;
    written|ready)
      cp "$src" "$outbox/$account.manifest.tmp" && sync "$outbox/$account.manifest.tmp"
      mv "$outbox/$account.manifest.tmp" "$outbox/$account.manifest.written" && sync "$outbox"
      if [[ "$stage" == ready ]]; then mv "$outbox/$account.manifest.written" "$outbox/$account.manifest.ready" && sync "$outbox"; fi ;;
  esac
done

sleep "$(value sleep || true)" 2>/dev/null || sleep 1
code="$(value exit)"
if [[ "$code" == kill ]]; then kill -KILL $$; fi
exit "${code:-0}"
