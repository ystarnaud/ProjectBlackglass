<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Blackglass.Accounts.Persistence</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- One copy of the migrations: the files in db/migrations, embedded so the image needs no file layout. -->
    <EmbeddedResource Include="..\..\db\migrations\*.sql" LogicalName="migrations.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Accounts.Domain\Accounts.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test seams only (SettlementStore.PlanFilterForTests): never used by the API. -->
    <InternalsVisibleTo Include="Accounts.Integration.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
</Project>
