<Project Sdk="Microsoft.NET.Sdk">
  <!-- The root credential broker (Phase 13 Stage 10, security correction I3): the only agent-facing code that runs as root.
       Socket-activated per connection (deploy/mission/blackglass-credential.socket); it takes a canonical attempt id, a
       generation and a pc1 credential and writes /run/blackglass/credentials/<attempt>/process for the mission unit's
       LoadCredential. No project reference: everything it trusts is in this directory. Published with the agent. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Blackglass.MissionHost.CredentialBroker</RootNamespace>
    <AssemblyName>blackglass-credential-broker</AssemblyName>
    <!-- No ICU: the broker handles ASCII only, and a root process should load as little as it can. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MissionHost.Agent.Tests" />
    <InternalsVisibleTo Include="Accounts.Integration.Tests" />
  </ItemGroup>
</Project>
