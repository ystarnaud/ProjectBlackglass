<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Blackglass.Accounts.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\Accounts.Api\Accounts.Api.csproj" />
    <ProjectReference Include="..\..\src\Accounts.Persistence\Accounts.Persistence.csproj" />
    <!-- The mission host agent, driven against the real API (Agent/AgentBackendTests). -->
    <ProjectReference Include="..\..\src\MissionHost.Agent\MissionHost.Agent.csproj" />
    <ProjectReference Include="..\..\src\MissionHost.CredentialBroker\MissionHost.CredentialBroker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\db\invariants\*.sql" Link="invariants\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Seeds\*.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- src/ for the string-built-SQL source audit (SqlSourceAuditTests). -->
    <None Include="..\..\src\**\*.cs" Exclude="..\..\src\**\obj\**;..\..\src\**\bin\**" Link="source\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shared inventory vectors, replayed against PostgreSQL by InventoryEditStoreTests. -->
    <None Include="..\..\contracts\inventory\*" Link="contracts\inventory\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deploy\services\compose*.yaml" Link="compose\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
